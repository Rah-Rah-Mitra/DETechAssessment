        <mxCell id="callout" value="&lt;b&gt;Storage &amp;#8212; purge controls&lt;/b&gt;&lt;br&gt;&lt;br&gt;S3 lifecycle: Expiration 7 d per prefix&lt;br&gt;&amp;#183; abort incomplete MPU after 1 d&lt;br&gt;&amp;#183; versioning off &amp;#183; Object Lock off&lt;br&gt;&amp;#183; DynamoDB TTL, PITR off&lt;br&gt;&amp;#183; Kafka retention.ms = 7 d&lt;br&gt;&amp;#183; SQS + DLQ retention 4 d&lt;br&gt;&amp;#183; Athena results 1 d &amp;#183; no SPICE&lt;br&gt;&amp;#183; CloudWatch Logs 7 d&lt;br&gt;&amp;#183; ECS ephemeral storage dies with task" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;size=18;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1720" y="200" width="260" height="215" as="geometry" /></mxCell>
