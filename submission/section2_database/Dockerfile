# Section 2 -- containerised PostgreSQL for the e-commerce sales database.
#
# The official image runs every .sql/.sh in /docker-entrypoint-initdb.d/ in
# lexical order, but ONLY when the data directory is empty. That is why the DDL
# files are numbered, and why `docker compose down -v` (which drops the named
# volume) is the way to re-seed from scratch.
FROM postgres:16

# ddl/01_schema.sql  -- tables, constraints, indexes, totals trigger
# ddl/02..04_*.sql   -- seed, generated by ../generate_seed.py
COPY ddl/ /docker-entrypoint-initdb.d/
