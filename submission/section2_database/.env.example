# Section 2 -- local database credentials.
#
#   cp .env.example .env
#
# .env is gitignored (see the repo root .gitignore); this template is what gets
# committed. These are throwaway local-development values: the container is not
# meant to be exposed beyond localhost, and nothing here should ever be reused
# for a real deployment.

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_local_dev
POSTGRES_DB=ecommerce

# Optional. Set this if something already owns 5432 on your host.
# HOST_PORT=15432
